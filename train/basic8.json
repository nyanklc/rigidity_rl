        "        graph_latent = global_mean_pool(h.reshape(-1, h.shape[-1]), batch_mapping)",
        "",
        "        # print(f\"hey h: {h.shape}, new: {new_embeddings.shape}, latent: {graph_latent.shape}\")",
        "        value = self.head(graph_latent)",
