        "        n = node_features.shape[1]",
        "        batch_size = node_features.shape[0]",
        "",
        "        # batch",
        "        edge_index_list = []",
        "        edge_attr_list = []",
        "        for i in range(batch_size):",
        "            src, dst = adj[i].nonzero(as_tuple=True)",
        "",
        "            edge_index = torch.stack([src, dst], dim=0) + i * n",
